# Secret used to sign session JWTs (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string
# Razorpay test keys from https://dashboard.razorpay.com/app/keys
# Leave empty to use demo payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database (Neon Postgres) ----
# Put these two in `.env` (Prisma CLI reads .env, not .env.local).
# Neon dashboard → Connect → "Pooled connection" for DATABASE_URL, direct (no -pooler) for DIRECT_URL.
# Do NOT add pgbouncer=true: Neon's pooler supports Prisma natively and that flag makes every query ~5× slower.
# connect_timeout: Neon may take a few seconds to wake from idle.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Firebase Phone Auth (mobile OTP) ----
# Firebase console → Project settings → Your apps → Web app config.
# Leave empty in development to use dev OTP mode (code shown on screen + server console).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Razorpay webhook (Dashboard → Settings → Webhooks) ----
# URL: https://<your-domain>/api/webhooks/razorpay  · Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
# Allow simulated "demo" payments when Razorpay keys are missing (always allowed in dev).
# true = portfolio/demo deployment; false = real shop (checkout closes if keys are missing).
ALLOW_DEMO_PAYMENTS=false

# ---- Order emails (https://resend.com — verify your domain there first) ----
RESEND_API_KEY=
EMAIL_FROM="Aurelia <orders@yourdomain.in>"
