{
  "name": "aurelia-jewellery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});console.log('.next removed')\"",
    "dev:webpack": "next dev",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "dev:local": "node scripts/dev-local.mjs",
    "db:stop": "node scripts/dev-local.mjs stop",
    "db:seed:prod": "tsx prisma/seed.ts --production",
    "admin:create": "tsx scripts/admin.ts create",
    "admin:remove-demo": "tsx scripts/admin.ts remove-demo",
    "demo:accounts": "tsx scripts/demo-accounts.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "2.4.3",
    "firebase": "13.3.0",
    "jose": "5.9.6",
    "lucide-react": "^0.460.0",
    "next": "15.5.29",
    "nodemailer": "10.5.0",
    "prisma": "^5.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "^17.2.0-beta.15",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
